# AGS / Node
**/node_modules/
**/.npm/
**/.yarn/
**/dist/
**/*.log

# Backups / saves
**/*.bak
**/*.save
**/*.save.*
**/*~ 

# Editor / OS
.DS_Store
.vscode/

# AGS private Spotify auth
config/ags/private/*
!config/ags/private/spotify-auth.example.json
!config/ags/private/.gitkeep

# Private environment files
**/*.env
!**/*.env.example

# Python cache
**/__pycache__/
**/*.pyc

# Local systemd user links (machine-specific)
config/systemd/user/default.target.wants/

# Quickshell language-server state (machine-specific)
config/quickshell/.qmlls.ini

[Unit]
Description=Polar legacy manual prototype (use quickshell.service)
Documentation=https://quickshell.org/docs/v0.3.0/
PartOf=graphical-session.target
After=graphical-session.target
Conflicts=ags.service quickshell.service waybar.service

[Service]
Type=simple
ExecStart=/usr/bin/quickshell --path %h/.config/quickshell
Restart=on-failure
RestartSec=2

# Intentionally no [Install] section: this prototype must be started explicitly.
